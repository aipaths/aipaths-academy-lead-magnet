# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a git (está en .gitignore). No pongas comillas.

# Link de tu hoja de Google (el de la barra del navegador)
HOJA=
# Dirección de la puerta: la aplicación web de Apps Script (termina en /exec)
URL=
# Contraseña de la puerta (32 caracteres hexadecimales). El mismo valor va en
# las Propiedades del script de Apps Script, con la clave TOKEN.
TOKEN=
